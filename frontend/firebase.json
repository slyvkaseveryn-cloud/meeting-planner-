{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*"],
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "spry-severyn-api", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
